generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Denuncia {
  id          Int      @id @default(autoincrement())
  tipo        String
  descricao   String
  local       String
  nome        String?
  email       String?
  anonimo     Boolean  @default(false)
  criadoEm    DateTime @default(now())
}